{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      { "command": "curl -sf -m 10 -X POST http://127.0.0.1:4319/hook/cursor-prompt --data-binary @- || exit 0", "timeout": 10 }
    ],
    "afterAgentResponse": [
      { "command": "curl -sf -m 10 -X POST http://127.0.0.1:4319/hook/cursor-response --data-binary @- || exit 0", "timeout": 10 }
    ]
  }
}
