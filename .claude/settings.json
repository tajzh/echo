{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "curl -sf -m 10 -X POST http://127.0.0.1:4319/hook/cc-prompt --data-binary @- || exit 0", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "curl -sf -m 60 -X POST http://127.0.0.1:4319/hook/cc-stop --data-binary @- || exit 0", "timeout": 60 } ] }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "curl -sf -m 3 http://127.0.0.1:4319/statusline || exit 0"
  }
}
